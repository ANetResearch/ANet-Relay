{
  "name": "@anet-relay/web",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "ANet Relay renderer: Vite + React 19 + TypeScript + Tailwind 4 + shadcn (base-mira).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "types": "node scripts/gen-types.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run types:check && npm run build",
    "shots": "node scripts/shots.mjs",
    "types:check": "node scripts/gen-types.mjs --check"
  },
