<?xml version="1.0"?>
<robot name="x500_drone">


  <!-- 材料定义 -->
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.8 0.8 0.8 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <!-- 1. 基座连杆 (Base Link) - 无人机机身 -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/NXP-HGD-CF.dae" scale="1 1 1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.4 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.03"/>
    </inertial>
    
    <!-- IMU传感器 -->
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <imu>
        <noise>
          <type>gaussian</type>
          <rate>
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
            <bias_mean>0.0000075</bias_mean>
            <bias_stddev>0.0000008</bias_stddev>
          </rate>
          <accel>
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
            <bias_mean>0.1</bias_mean>
            <bias_stddev>0.001</bias_stddev>
          </accel>
        </noise>
      </imu>
    </sensor>
  </link>

  
  <!-- GPS传感器 -->
  <link name="gps_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  

  <!-- 相机传感器 -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.02"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.1 0 0.02" rpy="0 0 0"/>
  </joint>

 

  <!-- 电机定义 -->
  <!-- 前右电机 -->
  <link name="motor_fr_base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Base.dae" scale="1 1 1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="motor_fr_bell_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Bell.dae" scale="1 1 1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="motor_fr_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_fr_base_link"/>
    <origin xyz="0.18 0.18 0.00" rpy="0 0 0"/>
  </joint>

  <joint name="motor_fr_bell_joint" type="continuous">
    <parent link="motor_fr_base_link"/>
    <child link="motor_fr_bell_link"/>
    <origin xyz="0 0 -0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

 

  <!-- 前左电机 -->
  <link name="motor_fl_base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Base.dae" scale="1 1 1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="motor_fl_bell_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Bell.dae" scale="1 1 1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="motor_fl_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_fl_base_link"/>
    <origin xyz="0.18 -0.18 0.0" rpy="0 0 0"/>
  </joint>

  <joint name="motor_fl_bell_joint" type="continuous">
    <parent link="motor_fl_base_link"/>
    <child link="motor_fl_bell_link"/>
    <origin xyz="0 0 -0.015" rpy="0 0 1.5708"/>
    <axis xyz="0 0 1"/>
  </joint>



  <!-- 后左电机 -->
  <link name="motor_rl_base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Base.dae" scale="1 1 1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="motor_rl_bell_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Bell.dae" scale="1 1 1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="motor_rl_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_rl_base_link"/>
    <origin xyz="-0.18 -0.18 0.00" rpy="0 0 0"/>
  </joint>

  <joint name="motor_rl_bell_joint" type="continuous">
    <parent link="motor_rl_base_link"/>
    <child link="motor_rl_bell_link"/>
    <origin xyz="0 0 -0.015" rpy="0 0 3.1416"/>
    <axis xyz="0 0 1"/>
  </joint>


  <!-- 后右电机 -->
  <link name="motor_rr_base_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Base.dae" scale="1 1 1"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.02" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="motor_rr_bell_link">
    <visual>
      <geometry>
        <mesh filename="file:///home/lcx/drone_ws/src/yydrone_description/meshes/x500/5010Bell.dae" scale="1 1 1"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <cylinder length="0.01" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="motor_rr_base_joint" type="fixed">
    <parent link="base_link"/>
    <child link="motor_rr_base_link"/>
    <origin xyz="-0.18 0.18 0.0" rpy="0 0 0"/>
  </joint>

  <joint name="motor_rr_bell_joint" type="continuous">
    <parent link="motor_rr_base_link"/>
    <child link="motor_rr_bell_link"/>
    <origin xyz="0 0 -0.015" rpy="0 0 -1.5708"/>
    <axis xyz="0 0 1"/>
  </joint>

 

</robot>
