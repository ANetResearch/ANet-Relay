<?xml version="1.0"?>
<sdf version="1.7">
  <world name="urban_drone_course">
    
    <!-- 环境设置 -->
    <include>
      <uri>model://sun</uri>
    </include>
    
    <!-- 地面平面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 物理引擎设置 -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <gravity>0 0 -9.8</gravity>
    </physics>

    <!-- 场景设置 -->
    <scene>
      <ambient>0.4 0.4 0.4 1.0</ambient>
      <background>0.7 0.7 0.8 1.0</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- 现代建筑结构 -->
    <model name="modern_building">
      <pose>8 5 0 0 0 0</pose>
      <static>true</static>
      <link name="main_structure">
        <pose>0 0 4 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>6 8 8</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6 8 8</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
      <!-- 建筑细节 -->
      <link name="roof_detail">
        <pose>0 0 8.5 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>7 9 1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.3 0.3 0.3 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 工业集装箱堆 -->
    <model name="container_stack_1">
      <pose>-6 8 1.5 0 0 0</pose>
      <static>true</static>
      <link name="container_1">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.4 6 2.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.4 6 2.9</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 0.0 0.0 1</ambient>
            <diffuse>1.0 0.0 0.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="container_stack_2">
      <pose>-6 8 4.4 0 0 0</pose>
      <static>true</static>
      <link name="container_2">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.4 6 2.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.4 6 2.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.0 1.0 1</ambient>
            <diffuse>0.0 0.0 1.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 倾斜的集装箱 -->
    <model name="angled_container">
      <pose>0 -8 1.5 0 0 0.785</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>2.4 12 2.9</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>2.4 12 2.9</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 1.0 0.0 1</ambient>
            <diffuse>0.0 1.0 0.0 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 高架通道 -->
    <model name="overhead_passage">
      <pose>-5 0 5 0 1.57 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>10 1 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>10 1 0.5</size>
            </box>
          </geometry>
          <material>
            <ambient>1.0 1.0 1.0 1</ambient>
            <diffuse>1.0 1.0 1.0 1</diffuse>
            <specular>0.5 0.5 0.5 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 支撑柱 -->
    <model name="support_column_1">
      <pose>-5 4.5 2.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="support_column_2">
      <pose>-5 -4.5 2.5 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 第一台高级轿车 - 运动轿跑 -->
    <model name="sports_coupe">
      <pose>-3 -3 0.35 0 0 0.8</pose>
      <static>true</static>
      
      <!-- 主车身 -->
      <link name="main_body">
        <pose>0 0 0.3 0 0 0</pose>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>4.2 1.8 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>4.2 1.8 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Red</name>
            </script>
          </material>
        </visual>
        
        <!-- 车顶 -->
        <visual name="roof_visual">
          <pose>0.3 0 0.4 0 0 0</pose>
          <geometry>
            <box>
              <size>3.0 1.5 0.3</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        
        <!-- 前保险杠 -->
        <visual name="bumper_visual">
          <pose>2.1 0 0.2 0 0 0</pose>
          <geometry>
            <box>
              <size>0.3 1.8 0.2</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
      
      <!-- 车轮 -->
      <link name="front_left_wheel">
        <pose>1.3 0.85 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tire_visual">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <visual name="rim_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="front_right_wheel">
        <pose>1.3 -0.85 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tire_visual">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <visual name="rim_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="rear_left_wheel">
        <pose>-1.3 0.85 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tire_visual">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <visual name="rim_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>

      <link name="rear_right_wheel">
        <pose>-1.3 -0.85 0.15 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tire_visual">
          <geometry>
            <cylinder>
              <radius>0.32</radius>
              <length>0.22</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <visual name="rim_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.22</radius>
              <length>0.24</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 第二台高级轿车 - 豪华SUV -->
    <model name="luxury_suv">
      <pose>4 2 0.45 0 0 -0.6</pose>
      <static>true</static>
      
      <!-- 主车身 -->
      <link name="main_body">
        <pose>0 0 0.4 0 0 0</pose>
        <collision name="body_collision">
          <geometry>
            <box>
              <size>4.8 2.0 0.6</size>
            </box>
          </geometry>
        </collision>
        <visual name="body_visual">
          <geometry>
            <box>
              <size>4.8 2.0 0.6</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
        
        <!-- 上层结构 -->
        <visual name="upper_body">
          <pose>0 0 0.5 0 0 0</pose>
          <geometry>
            <box>
              <size>4.0 1.7 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkBlue</name>
            </script>
          </material>
        </visual>
        
        <!-- 车顶行李架 -->
        <visual name="roof_rack">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry>
            <box>
              <size>3.5 1.8 0.05</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/White</name>
            </script>
          </material>
        </visual>
      </link>
      
      <!-- 车轮 (SUV规格) -->
      <link name="front_left_wheel">
        <pose>1.4 1.0 0.2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>0.28</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="tire_visual">
          <geometry>
            <cylinder>
              <radius>0.38</radius>
              <length>0.28</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
        <visual name="rim_visual">
          <pose>0 0 0.01 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.25</radius>
              <length>0.3</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>

      <!-- 其他三个车轮类似... -->

    </model>

    <!-- 环境装饰 - 树木 -->
    <model name="tree_1">
      <pose>-10 -10 0 0 0 0</pose>
      <static>true</static>
      <link name="trunk">
        <pose>0 0 1.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>3</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>3</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 3.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>1.5</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>1.5</radius>
            </sphere>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Green</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name="tree_2">
      <pose>12 12 0 0 0 0</pose>
      <static>true</static>
      <link name="trunk">
        <pose>0 0 2 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>4</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.4</radius>
              <length>4</length>
            </cylinder>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
      <link name="foliage">
        <pose>0 0 4.5 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <sphere>
              <radius>2</radius>
            </sphere>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <sphere>
              <radius>2</radius>
            </sphere>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/DarkGreen</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>