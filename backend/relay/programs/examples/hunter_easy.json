{
  "name": "Hunter (easy)",
  "name_zh": "猎手（简单）",
  "description": "Arena bot: searches, approaches and fires; slow to react and does not evade.",
  "description_zh": "对抗机器人：搜索、接近并射击；反应慢，不规避。",
  "tests": [
    {
      "name": "No contact searches",
      "obs": {
        "contacts": []
      },
      "expect": {
        "fire": false,
        "state": "search"
      }
    },
    {
      "name": "Target dead ahead is shot",
      "state": "shoot",
      "obs": {
        "hp": 100,
        "contacts": [
          {
            "id": "sim-2",
            "team": "sim-2",
            "dist": 4.0,
            "bearing": 0.0,
            "elevation": 0.0,
            "rel": [
              4.0,
              0.0,
              0.0
            ],
            "vrel": [
              0.0,
              0.0,
              0.0
            ],
            "hp": 100
          }
        ]
      },
      "expect": {
        "fire": true
      }
    },
    {
      "name": "Target to the right turns right",
      "state": "approach",
      "obs": {
        "contacts": [
          {
            "id": "sim-2",
            "team": "sim-2",
            "dist": 5.0,
            "bearing": 37.0,
            "elevation": 0.0,
            "rel": [
              4.0,
              3.0,
              0.0
            ],
            "vrel": [
              0.0,
              0.0,
              0.0
            ],
            "hp": 100
          }
        ]
      },
      "expect": {
        "yaw": [
          0.05,
          1.0
        ],
        "fire": false
      }
    },
    {
      "name": "A rammer coming straight in: side-step",
      "state": "approach",
      "obs": {
        "contacts": [
          {
            "id": "sim-2",
            "team": "sim-2",
            "dist": 2.5,
            "bearing": 0.0,
            "elevation": 0.0,
            "rel": [
              2.5,
              0.0,
              0.0
            ],
            "vrel": [
              -3.0,
              0.0,
              0.0
            ],
            "hp": 100
          }
        ]
      },
      "expect": {
        "roll": [
          0.5,
          1.0
        ],
        "fire": false,
        "state": "dodge"
      }
    },
    {
      "name": "Team mates are not targets",
      "state": "search",
      "params": {
        "team": "team-1"
      },
      "obs": {
        "contacts": [
          {
            "id": "sim-3",
            "team": "team-1",
            "dist": 4.0,
            "bearing": 0.0,
            "elevation": 0.0,
            "rel": [
              4.0,
              0.0,
              0.0
            ],
            "vrel": [
              0.0,
              0.0,
              0.0
            ],
            "hp": 100
          }
        ]
      },
      "expect": {
        "fire": false,
        "state": "search"
      }
    }
  ]
}
