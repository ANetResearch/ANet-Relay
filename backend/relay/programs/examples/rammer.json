{
  "name": "Rammer",
  "name_zh": "撞击机",
  "description": "Arena bot: proportional-navigation pursuit of the nearest enemy, weaving across the line of sight on the way in, full push at close range to ram it, then levels out after the contact. Never fires.",
  "description_zh": "对抗机器人：以比例导引追击最近的敌机，接近途中横向蛇形机动，近距离全力加速对撞，撞后稳住姿态再寻找目标；从不开火。",
  "tests": [
    {
      "name": "Climbs to the cruise height first",
      "state": "climb",
      "obs": {"alt": 0.3, "contacts": []},
      "expect": {"throttle": [0.55, 1.0], "fire": false, "state": "climb"}
    },
    {
      "name": "No contact searches by turning",
      "state": "search",
      "obs": {"alt": 1.5, "contacts": []},
      "expect": {"yaw": [0.2, 0.5], "fire": false, "state": "search"}
    },
    {
      "name": "A contact starts the pursuit",
      "state": "search",
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 6.0, "bearing": 0.0, "elevation": 0.0, "rel": [6.0, 0.0, 0.0], "vrel": [0.0, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"fire": false, "state": "pursue"}
    },
    {
      "name": "Target to the right: turns and pushes right",
      "state": "pursue",
      "params": {"weave": 0},
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 5.0, "bearing": 36.87, "elevation": 0.0, "rel": [4.0, 3.0, 0.0], "vrel": [0.0, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"roll": [0.1, 0.8], "pitch": [0.1, 0.8], "yaw": [0.3, 1.0], "fire": false, "state": "pursue"}
    },
    {
      "name": "Proportional navigation leads a crossing target",
      "state": "pursue",
      "params": {"weave": 0},
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 5.0, "bearing": 0.0, "elevation": 0.0, "rel": [5.0, 0.0, 0.0], "vrel": [-1.0, 1.5, 0.0], "closing": 1.0, "hp": 100}
        ]
      },
      "expect": {"roll": [0.05, 0.8], "pitch": [0.1, 0.8], "fire": false}
    },
    {
      "name": "Close and closing: full push to ram",
      "state": "pursue",
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 2.0, "bearing": 0.0, "elevation": 0.0, "rel": [2.0, 0.0, 0.0], "vrel": [-1.5, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"pitch": [0.7, 0.8], "fire": false, "state": "ram"}
    },
    {
      "name": "Weaves across the line of sight on the way in",
      "state": "pursue",
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 6.0, "bearing": 0.0, "elevation": 0.0, "rel": [6.0, 0.0, 0.0], "vrel": [0.0, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"roll": [0.5, 0.8], "pitch": [0.4, 0.8], "fire": false, "state": "pursue"}
    },
    {
      "name": "A contact moves to recovery with the sticks centred",
      "state": "ram",
      "obs": {
        "alt": 1.5,
        "collision": {"t_ago": 0.1, "with": "sim-2", "v_rel": 2.4, "normal": [0.0, -1.0, 0.0]},
        "contacts": [
          {"id": "sim-2", "team": "sim-2", "dist": 0.4, "bearing": 0.0, "elevation": 0.0, "rel": [0.4, 0.0, 0.0], "vrel": [0.5, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"roll": [0.0, 0.0], "pitch": [0.0, 0.0], "fire": false, "state": "recover"}
    },
    {
      "name": "Team mates are not targets",
      "state": "search",
      "params": {"team": "team-1"},
      "obs": {
        "alt": 1.5,
        "contacts": [
          {"id": "sim-3", "team": "team-1", "dist": 3.0, "bearing": 0.0, "elevation": 0.0, "rel": [3.0, 0.0, 0.0], "vrel": [0.0, 0.0, 0.0], "hp": 100}
        ]
      },
      "expect": {"fire": false, "state": "search"}
    }
  ]
}
