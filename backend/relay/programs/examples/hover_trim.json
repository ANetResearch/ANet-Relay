{
  "name": "Hover trim",
  "name_zh": "悬停配平",
  "description": "Climbs to target_alt and holds it on the barometer; an integrator learns the hover throttle. Attitude stays level.",
  "description_zh": "爬升到 target_alt 并依据气压高度保持；积分项学习悬停油门，姿态保持水平。",
  "tests": [
    {"name": "Below target climbs", "obs": {"alt": 0.5, "vz": 0.0}, "expect": {"throttle": [0.55, 1.0], "roll": [0, 0], "pitch": [0, 0], "state": "climb"}},
    {"name": "Above target descends", "obs": {"alt": 1.5, "vz": 0.0}, "expect": {"throttle": [0.0, 0.45]}},
    {"name": "At target holds", "obs": {"alt": 1.0, "vz": 0.0}, "expect": {"throttle": [0.45, 0.55], "state": "hold"}},
    {"name": "Disarmed idles", "obs": {"armed": false, "airborne": false}, "expect": {"throttle": [0, 0], "state": "disarmed"}}
  ]
}
