{
  "name": "Figure-eight evader",
  "name_zh": "8 字闪避机",
  "description": "Arena bot for a position source (deploy with sensors position gps or uwb): flies a figure eight around the arena centre, weaves its height, and dodges sideways and up or down when an aircraft of another team closes in fast. Never fires.",
  "description_zh": "需要位置源的对抗机器人（部署时 sensors.position 设为 gps 或 uwb）：绕场地中心飞 8 字、高度缓慢起伏，另一队飞机快速逼近时横向并上下闪避；从不开火。",
  "tests": [
    {
      "name": "Without a position source it only holds height",
      "obs": {"alt": 1.6, "pos": null, "vel": null},
      "expect": {"roll": [-0.01, 0.01], "pitch": [-0.01, 0.01], "fire": false, "state": "no position"}
    },
    {
      "name": "Low after take-off: climbs first",
      "obs": {"alt": 0.3, "pos": [0.0, 0.0, 0.3], "vel": [0.0, 0.0, 0.0]},
      "expect": {"throttle": [0.55, 1.0], "fire": false, "state": "climb"}
    },
    {
      "name": "On the eight: leans along the path (north-east at the start, facing north)",
      "obs": {"alt": 1.6, "yaw": 0.0, "pos": [0.0, 0.0, 1.6], "vel": [0.0, 0.0, 0.0]},
      "expect": {"roll": [0.05, 0.8], "pitch": [0.05, 0.8], "fire": false, "state": "eight"}
    },
    {
      "name": "An enemy closing fast starts a dodge",
      "obs": {
        "alt": 1.6, "yaw": 0.0, "pos": [0.0, 0.0, 1.6], "vel": [0.0, 0.0, 0.0],
        "contacts": [
          {"id": "sim-2", "team": "B", "dist": 2.0, "bearing": 0.0, "elevation": 0.0, "rel": [2.0, 0.0, 0.0], "vrel": [-3.0, 0.0, 0.0], "closing": 3.0, "hp": 100}
        ]
      },
      "expect": {"fire": false, "state": "dodge"}
    },
    {
      "name": "A teammate is never a threat",
      "params": {"team": "A"},
      "obs": {
        "alt": 1.6, "yaw": 0.0, "pos": [0.0, 0.0, 1.6], "vel": [0.0, 0.0, 0.0],
        "contacts": [
          {"id": "sim-2", "team": "A", "dist": 2.0, "bearing": 0.0, "elevation": 0.0, "rel": [2.0, 0.0, 0.0], "vrel": [-3.0, 0.0, 0.0], "closing": 3.0, "hp": 100}
        ]
      },
      "expect": {"fire": false, "state": "eight"}
    }
  ]
}
